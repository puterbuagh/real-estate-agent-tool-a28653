# Supabase — shared instance, isolated schema
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key # Supabase anon/public key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # Server-only service role key
SUPABASE_SCHEMA=agentdesk # Postgres schema name for this app (shared-schema mode)
NEXT_PUBLIC_SUPABASE_SCHEMA=agentdesk # Mirror of SUPABASE_SCHEMA for browser clients

# FRED (Federal Reserve Economic Data) — free, no credit card
# Used by /api/mortgage-rate and the Market Stats page (MORTGAGE30US + MORTGAGE15US).
# Get a key at https://fred.stlouisfed.org/docs/api/api_key.html
NEXT_PUBLIC_FRED_API_KEY=your-fred-api-key

# RapidAPI — Zillow property data (Property Comparator), server-side only
RAPIDAPI_KEY=your-rapidapi-key # RapidAPI key for zillow-com1.p.rapidapi.com — used only in server routes/helpers
