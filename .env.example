# Supabase — shared instance, isolated schema
# Authentication is REQUIRED for all routes except /login and /signup.
# Sessions are managed via @supabase/ssr cookies and protected by middleware.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key # Supabase anon/public key (safe for browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # Server-only service role key — never expose
NEXT_PUBLIC_SUPABASE_SCHEMA=agentdesk # Postgres schema name for this app (shared-schema mode)

# FRED (Federal Reserve Economic Data) — free, no credit card
# SERVER-ONLY. Used by /api/mortgage-rate and the Market Stats server component.
# Get a key at https://fred.stlouisfed.org/docs/api/api_key.html
# Do NOT expose this to the browser. There is no NEXT_PUBLIC_ variant.
FRED_API_KEY=your-fred-api-key # Server-only FRED API key for live mortgage rate data

# ---------------------------------------------------------------------------
# ATTOM Data — Property + AVM + Sales Comparables
# ---------------------------------------------------------------------------
# SERVER-ONLY secret. Consumed by lib/attom.ts and /api/property-lookup.
# AgentDesk uses three ATTOM endpoints:
#   • /propertyapi/v1.0.0/property/detail        — beds/baths/sqft/year built/lot
#   • /propertyapi/v1.0.0/attomavm/detail        — AVM estimated value (price proxy)
#   • /propertyapi/v1.0.0/saleshistory/detail    — recent sales history for context
# Falls back to /property/basicprofile by lat/lng if address-based lookup misses.
#
# Get a key at https://api.developer.attomdata.com/ (Sign up → Apps → Create App).
# Ensure your subscription includes Property API, AVM API, and Sales History API.
# Do NOT expose this to the browser. There is no NEXT_PUBLIC_ variant.
# ---------------------------------------------------------------------------
ATTOM_API_KEY=your-attom-api-key # Server-only ATTOM Data API key (Property + AVM + Sales History access)

# RapidAPI — Zillow Live Data Scraper (DEPRECATED)
# No longer used by AgentDesk. Kept here for backward compatibility only.
# Safe to remove from your environment.
RAPIDAPI_KEY= # DEPRECATED — AgentDesk now uses ATTOM_API_KEY instead

# ---------------------------------------------------------------------------
# Google Maps API Key (Places Autocomplete, Maps JS)
# ---------------------------------------------------------------------------
# Used for Google Places Autocomplete in the Property Comparator address inputs.
# Read directly on the client — no API route, no per-user storage.
#
# TROUBLESHOOTING AUTOCOMPLETE NOT WORKING:
#   • Verify NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is set in the Vercel project (Production + Preview).
#   • In Google Cloud Console, enable BOTH:
#       - "Places API" (https://console.cloud.google.com/apis/library/places-backend.googleapis.com)
#       - "Maps JavaScript API" (https://console.cloud.google.com/apis/library/maps-backend.googleapis.com)
#   • Confirm billing is enabled on the GCP project.
#   • If the key is restricted by HTTP referrer, add your AgentDesk domains:
#       https://*.vercel.app/*  and  https://your-prod-domain.com/*  and  http://localhost:3000/*
#   • Open the browser console and look for [gmaps] / [AddressInputs] debug logs.
#     Force-enable in production with:
#       localStorage.setItem('agentdesk:debug:gmaps','1')
#     then reloading.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key # Client-side Google Maps/Places API key (referrer-restricted, Places API + Maps JS API enabled)

# GOOGLE_API_KEY — generic Google API key (server-side use, currently unused)
GOOGLE_API_KEY=your-google-api-key # Optional server-side Google API key reserved for future server features

# NEXT_PUBLIC_FRED_API_KEY — reserved for client-side fallback. NOT recommended.
# Leave blank in production. The server route /api/mortgage-rate is the source of truth.
NEXT_PUBLIC_FRED_API_KEY= # Leave blank — server-side FRED_API_KEY is the only path used

# ---------------------------------------------------------------------------
# DEMO PASSWORD — /demo Page Access Control Only
# ---------------------------------------------------------------------------
# This password is ONLY used by the /api/demo-auth route to validate access to the /demo page.
# It does NOT authenticate users or interact with Supabase Auth.
#
# SETUP INSTRUCTIONS:
#   1. Choose a simple access code (e.g., "demo2024")
#   2. Set DEMO_PASSWORD environment variable to this value
#   3. In Supabase Dashboard → Authentication → Users → Add User:
#      - Email: demo@agentdesk.app
#      - Password: (choose a SEPARATE password for actual Supabase authentication — can be the same or different)
#      - Auto Confirm User: Yes
#   4. Run lib/supabase/migrations/006_seed_demo_user.sql to populate profile data
#
# HOW IT WORKS:
#   - User visits /demo and enters DEMO_PASSWORD (step 1)
#   - /api/demo-auth validates this password matches the env var (access control)
#   - User clicks "Sign In as Demo User" button
#   - DemoLoginForm.tsx calls Supabase client signInWithPassword with demo@agentdesk.app and the REAL Supabase password (step 3)
#   - These two passwords can be different — DEMO_PASSWORD is just a gate, not a credential
#
# IMPORTANT:
#   - DEMO_PASSWORD = /demo page access control password (validated by /api/demo-auth)
#   - Supabase Auth password = actual authentication credential (validated by Supabase)
#   - These are separate concepts and can have different values
# ---------------------------------------------------------------------------
DEMO_PASSWORD=demo2024 # /demo page access control password (validated by /api/demo-auth route only)
