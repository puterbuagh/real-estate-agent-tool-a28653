# Supabase — shared instance, isolated schema
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key # Supabase anon/public key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # Server-only service role key
NEXT_PUBLIC_SUPABASE_SCHEMA=agentdesk # Postgres schema name for this app (shared-schema mode, used by both browser + server Supabase clients)

# FRED (Federal Reserve Economic Data) — free, no credit card
# SERVER-ONLY. Used by /api/mortgage-rate and the Market Stats server component (MORTGAGE30US + MORTGAGE15US).
# Do NOT prefix with NEXT_PUBLIC_ — that would inline the key into the browser bundle and allow quota abuse.
# Get a key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key # Server-only FRED API key for live mortgage rate data
NEXT_PUBLIC_FRED_API_KEY=your-fred-api-key # (Optional) legacy client-side fallback — prefer the server-only key above

# RapidAPI — Zillow Live Data Scraper
# SERVER-ONLY secret. Do NOT prefix with NEXT_PUBLIC_ — that would inline it into the browser bundle.
# Consumed by lib/zillow.ts and /api/property-lookup.
# See README + comments in lib/zillow.ts for full setup + troubleshooting.
RAPIDAPI_KEY=your-rapidapi-key # Server-only RapidAPI key for Zillow Live Data Scraper host

# ---------------------------------------------------------------------------
# Google API Key (Places, Maps, etc.)
# ---------------------------------------------------------------------------
# Used for Google Places Autocomplete in the Property Comparator address inputs.
#
# RESOLUTION ORDER (handled by /api/google-api-key):
#   1. Per-agent google_api_key stored on their agent_profiles row
#      (set on the Profile page; overrides the env var when present).
#   2. GOOGLE_API_KEY env var (server-only fallback below).
#
# TROUBLESHOOTING AUTOCOMPLETE NOT WORKING:
#   • Verify GOOGLE_API_KEY is set in the Vercel project (Production + Preview).
#   • In Google Cloud Console, enable BOTH:
#       - "Places API" (https://console.cloud.google.com/apis/library/places-backend.googleapis.com)
#       - "Maps JavaScript API" (https://console.cloud.google.com/apis/library/maps-backend.googleapis.com)
#   • Confirm billing is enabled on the GCP project (required even for free-tier usage).
#   • If the key is restricted by HTTP referrer, add your AgentDesk domains:
#       https://*.vercel.app/*  and  https://your-prod-domain.com/*  and  http://localhost:3000/*
#   • If an agent set a personal key on /profile, that key WINS over GOOGLE_API_KEY —
#     check agent_profiles.google_api_key for the signed-in user.
#   • Open the browser console and look for [gmaps] / [AddressInputs] debug logs.
#     You can force-enable them in production by running:
#       localStorage.setItem('agentdesk:debug:gmaps','1')
#     then reloading.
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=your-google-api-key # Server-only fallback Google API key (Places API + Maps JS API enabled, referrer-restricted)
NEXT_PUBLIC_GOOGLE_API_KEY=your-google-api-key # (Optional) legacy browser-side fallback — prefer agent profile key + GOOGLE_API_KEY
